<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <h1>
        <%= title %>
    </h1>

    
        <% if (locals.messages){ %>
            <ul>
            <% messages.forEach(message=> { %>
                <li>
                    <p>
                        <%=message.name%>: <%=message.text%>
                        <%=message.added.toLocaleString() %>
                    </p>
                </li>
            <% }); %>
        </ul>

         <% } else { %>
            <p>no messages available</p>
            <% } %>   

    <a href="/new">Add Message</a>

</body>

</html>